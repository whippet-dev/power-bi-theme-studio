{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "_comment_exclude": "work/ and tools/*/output/ are gitignored local scratch space. They are not production sources, and typechecking them lets a throwaway script break `npm run build` and therefore `npm test`.",
  "exclude": ["node_modules", "work", "tools/**/output", "dist"]
}
