{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "Probe 05 filter pane buckets",
  "dataColors": [
    "#12436D",
    "#28A197",
    "#801650",
    "#F46A25",
    "#3D3D3D"
  ],
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#12436D"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Times New Roman",
            "titleSize": 20
          }
        ],
        "filterCard": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#F46A25"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#28A197"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspacePane": [
          {
            "fontFamily": "Arial"
          }
        ]
      }
    }
  }
}
