{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "Probe 03 matrix hierarchy",
  "dataColors": [
    "#12436D",
    "#28A197",
    "#801650",
    "#F46A25",
    "#3D3D3D"
  ],
  "visualStyles": {
    "pivotTable": {
      "*": {
        "subTotals": [
          {
            "backColor": {
              "solid": {
                "color": "#FF00FF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#E5E0DA"
              }
            }
          }
        ]
      }
    }
  }
}
