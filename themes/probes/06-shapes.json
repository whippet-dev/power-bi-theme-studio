{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "Probe 06 shapes",
  "dataColors": [
    "#12436D",
    "#28A197",
    "#801650",
    "#F46A25",
    "#3D3D3D"
  ],
  "visualStyles": {
    "shape": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#12436D"
              }
            }
          }
        ],
        "outline": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#FF00FF"
              }
            },
            "weight": 4
          }
        ],
        "shape": [
          {
            "tileShape": "hexagon",
            "hexagonSlant": 40,
            "arrowStemWidth": 25,
            "arrowheadSize": 60,
            "octagonSnipSize": 40,
            "isocelesTriangleTipPosition": 20,
            "trapezoidSlant": 35
          }
        ],
        "text": [
          {
            "show": true,
            "text": "Shape probe",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 14
          }
        ]
      }
    }
  }
}
