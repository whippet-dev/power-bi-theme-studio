{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "Probe 04 line styling",
  "dataColors": [
    "#12436D",
    "#28A197",
    "#801650",
    "#F46A25",
    "#3D3D3D"
  ],
  "visualStyles": {
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "lineChartType": "smooth",
            "strokeWidth": 4,
            "showMarker": true,
            "markerShape": "diamond",
            "markerSize": 9
          }
        ],
        "markers": [
          {
            "borderShow": true,
            "borderColor": {
              "solid": {
                "color": "#FF00FF"
              }
            },
            "borderWidth": 2
          }
        ]
      }
    }
  }
}
