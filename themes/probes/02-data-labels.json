{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "Probe 02 data labels",
  "dataColors": [
    "#12436D",
    "#28A197",
    "#801650",
    "#F46A25",
    "#3D3D3D"
  ],
  "visualStyles": {
    "*": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FF00FF"
              }
            },
            "fontSize": 12,
            "enableTitleDataLabel": true,
            "titleColor": {
              "solid": {
                "color": "#00A000"
              }
            },
            "enableDetailDataLabel": true,
            "detailColor": {
              "solid": {
                "color": "#F46A25"
              }
            }
          }
        ]
      }
    }
  }
}
